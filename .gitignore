persona/
# Python bytecode — regenerated on every run of skills/blog-writer/sweep.py and
# on every import of it from the test suite (`file-hygiene`: never commit
# generated files).
__pycache__/
*.pyc

# ACR dependency resolutions are shared. Native artifacts and machine state
# are regenerated locally by acr realize.
/.agents/*
!/.agents/registry.lock
/.claude/skills/acr__*
/.claude/rules/acr__*
/.codex/skills/acr__*
/.cursor/skills/acr__*
/.cursor/rules/acr__*
